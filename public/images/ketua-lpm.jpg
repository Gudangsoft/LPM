<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="400" height="500">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8fafc"/>
      <stop offset="100%" style="stop-color:#e2e8f0"/>
    </linearGradient>
    <linearGradient id="suit" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e3a5f"/>
      <stop offset="100%" style="stop-color:#0f172a"/>
    </linearGradient>
    <linearGradient id="skin" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fcd5b5"/>
      <stop offset="100%" style="stop-color:#deb896"/>
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="500" fill="url(#bgGrad)" rx="20"/>
  
  <!-- Body/Suit -->
  <path d="M100 280 Q80 320 70 500 L330 500 Q320 320 300 280 Q250 260 200 260 Q150 260 100 280" fill="url(#suit)"/>
  
  <!-- Shirt collar -->
  <path d="M160 270 L200 330 L240 270" fill="white"/>
  <path d="M165 275 L200 320 L235 275" fill="#f1f5f9"/>
  
  <!-- Tie -->
  <path d="M190 280 L200 400 L210 280 L200 290 Z" fill="#1e40af"/>
  
  <!-- Neck -->
  <rect x="175" y="220" width="50" height="60" fill="url(#skin)" rx="10"/>
  
  <!-- Head -->
  <ellipse cx="200" cy="160" rx="80" ry="90" fill="url(#skin)"/>
  
  <!-- Hair -->
  <path d="M120 130 Q120 60 200 50 Q280 60 280 130 Q270 90 200 85 Q130 90 120 130" fill="#374151"/>
  <path d="M265 70 Q290 55 280 100 Q270 80 265 70" fill="#374151"/>
  
  <!-- Ears -->
  <ellipse cx="120" cy="160" rx="12" ry="20" fill="url(#skin)"/>
  <ellipse cx="280" cy="160" rx="12" ry="20" fill="url(#skin)"/>
  
  <!-- Glasses -->
  <rect x="140" y="140" width="45" height="35" rx="8" fill="none" stroke="#374151" stroke-width="4"/>
  <rect x="215" y="140" width="45" height="35" rx="8" fill="none" stroke="#374151" stroke-width="4"/>
  <line x1="185" y1="157" x2="215" y2="157" stroke="#374151" stroke-width="3"/>
  <line x1="260" y1="157" x2="280" y2="150" stroke="#374151" stroke-width="3"/>
  <line x1="140" y1="157" x2="120" y2="150" stroke="#374151" stroke-width="3"/>
  
  <!-- Eyes -->
  <ellipse cx="162" cy="157" rx="10" ry="8" fill="#1f2937"/>
  <ellipse cx="238" cy="157" rx="10" ry="8" fill="#1f2937"/>
  <circle cx="165" cy="155" r="3" fill="white"/>
  <circle cx="241" cy="155" r="3" fill="white"/>
  
  <!-- Eyebrows -->
  <path d="M145 130 Q162 125 180 130" fill="none" stroke="#374151" stroke-width="4" stroke-linecap="round"/>
  <path d="M220 130 Q238 125 255 130" fill="none" stroke="#374151" stroke-width="4" stroke-linecap="round"/>
  
  <!-- Nose -->
  <path d="M200 155 Q195 175 200 185 Q205 175 200 155" fill="#deb896"/>
  
  <!-- Smile -->
  <path d="M170 200 Q200 220 230 200" fill="none" stroke="#9ca3af" stroke-width="3" stroke-linecap="round"/>
  
  <!-- Label -->
  <rect x="100" y="440" width="200" height="40" rx="8" fill="#1e3a5f"/>
  <text x="200" y="467" text-anchor="middle" font-size="14" font-weight="bold" fill="white">KETUA LPM</text>
</svg>